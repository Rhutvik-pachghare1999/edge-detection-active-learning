# AECS-SDC runtime environment variables.
# Copy this file to .env and fill in real values.

# Network addresses for the legacy live supervisor / Raspberry Pi path.
LAPTOP_IP=192.168.0.248
PI_IP=192.168.0.82
PI_PORT=8001
SUPERVISOR_PORT=8000
FRAME_SERVER_PORT=8002

# Detection thresholds and buffer settings.
TAU_INITIAL=0.25
FRAME_RATE=10
BUFFER_SIZE=50
BUFFER_SECONDS=5

# Models used by both the live supervisor and the offline benchmark.
TEACHER_MODEL=PekingU/rtdetr_r50vd
STUDENT_MODEL=models/yolov8n.onnx

# Paths used by the live supervisor. The offline benchmark does NOT write here.
DB_PATH=data/events.db
CLIPS_DIR=clips
LOGS_DIR=logs

# ROS2 topic for the live hardware path.
ROS2_CAMERA_TOPIC=/warehouse_cam/image_raw

# Alert email for the live supervisor.
ALERT_EMAIL=your-email@example.com
ALERT_EMAIL_PASSWORD=CHANGEME_use_app_password
